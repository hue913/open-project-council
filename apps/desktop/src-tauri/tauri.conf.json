{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Project Council",
  "version": "0.1.0",
  "identifier": "org.openprojectcouncil.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm --filter @open-project-council/desktop web:dev",
    "beforeBuildCommand": "pnpm --filter @open-project-council/desktop web:build"
  },
  "app": {
    "windows": [{ "title": "Open Project Council", "width": 1000, "height": 720 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
