# Web / identity
APP_URL=http://localhost:5173
WEB_PORT=5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Worker runtime
WORKER_PORT=8787
WORKER_DATA_PATH=./data/worker-state.json
DATABASE_URL=

# PostgreSQL used by docker compose. Generate a long random password before starting.
POSTGRES_DB=council
POSTGRES_USER=council
POSTGRES_PASSWORD=

# Cloud secret envelope encryption. Production must use a KMS or Vault adapter.
ENVELOPE_KEK_BASE64=

# `local` is for an encrypted private self-hosted instance. Any public internet
# deployment must set KMS_PROVIDER=vault and supply a Vault Transit key.
KMS_PROVIDER=local
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_KEY=

# Only enable for an isolated local OpenAI-compatible mock. Never set in production.
ALLOW_INSECURE_MODEL_ENDPOINTS=false

# GitHub and Vercel are only used after a user grants their project access.
VERCEL_WEBHOOK_SECRET=

# Browser runner (Playwright + WebArena-compatible environments)
BROWSER_RUNNER_URL=http://localhost:8790
BROWSER_RUNNER_TOKEN=
BROWSER_RUNNER_DATA_DIR=./data/browser-runs
BROWSER_ALLOWED_ORIGINS=http://shopping.local,http://gitlab.local,http://forum.local,http://wiki.local
# Generate with: openssl rand -base64 32. Required for encrypted screenshot files in production.
BROWSER_RUNNER_SCREENSHOT_KEY_BASE64=

# WebArena-compatible site services. Start these separately and keep credentials out of source control.
WEBARENA_SHOPPING_URL=http://shopping.local
WEBARENA_GITLAB_URL=http://gitlab.local
WEBARENA_FORUM_URL=http://forum.local
WEBARENA_WIKI_URL=http://wiki.local
